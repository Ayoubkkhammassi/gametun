# ==========================================================================
# GameTun Backend — variables d'environnement (EXEMPLE)
# Copier ce fichier en `.env` et remplir les valeurs.
# NE JAMAIS committer le vrai fichier `.env` (il est dans .gitignore).
# ==========================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
# Origines autorisées (CORS) — séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Base de données PostgreSQL ---
# En local: PostgreSQL sur la machine, ou une base cloud gratuite (Neon/Supabase).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gametun?schema=public

# --- JWT / Auth ---
# Générer une clé forte: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access_secret_use_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_use_a_different_long_random_string
JWT_REFRESH_TTL=30d

# --- Sécurité / limites ---
# Fenêtre (ms) et nombre max de requêtes par IP pour le rate limiting global
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Âge minimum autorisé à l'inscription (protection des mineurs)
MIN_AGE=13

# --- Premium (placeholder — aucun secret de paiement dans l'app mobile) ---
PREMIUM_PRICE_TND=2.99
